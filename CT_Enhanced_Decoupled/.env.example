# ─── Root .env.example — docker-compose variable substitution template ────────
# Copy this file to .env and fill in real values. Never commit .env to git.
#
# Docker Compose reads this file automatically for ${...} variable substitution.
# Both frontend and backend containers get the keys from backend/.env via env_file,
# but this root file is also needed for ${VARIABLE} syntax in docker-compose.yml.

# Google Maps — needed by:
#   Frontend: serve.js injects as window.GOOGLE_MAPS_API_KEY (Maps JS SDK)
#   Backend:  /api/maps/directions + /api/maps/geocode proxy routes
# Requires these APIs enabled in Google Cloud Console:
#   ✅ Maps JavaScript API
#   ✅ Directions API
#   ✅ Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
