# ─── Charlapalli Terminal — Frontend ENV template ───────────────────────────
# Copy this file to .env and fill in real values. Never commit .env to git.
#
# In production (Docker), set VITE_GOOGLE_MAPS_API_KEY as an environment
# variable directly — the serve.js server reads it at startup and injects
# it into every HTML response as window.GOOGLE_MAPS_API_KEY.
#
# The same key value lives in backend/.env as GOOGLE_MAPS_API_KEY and is
# used by the /api/maps/directions server-side proxy.

# Google Maps — Maps JavaScript API (for live map rendering in navigate.html)
# Needs: Maps JavaScript API enabled in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
