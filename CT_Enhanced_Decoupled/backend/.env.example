# ─── Charlapalli Terminal — Backend ENV template ───────────────────────────
# Copy this file to .env and fill in real values. Never commit .env to git.

# Server
PORT=3001
NODE_ENV=development          # set to "production" in prod

# CORS — comma-separated list of allowed frontend origins
# Leave blank in development (all origins allowed)
FRONTEND_ORIGIN=https://charlapalli-railway-terminal.tride.live

# Sarvam AI (chatbot)
SARVAM_API_KEY=your_sarvam_key_here

# RapidAPI — Train Running Status
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=train-running-api.p.rapidapi.com
